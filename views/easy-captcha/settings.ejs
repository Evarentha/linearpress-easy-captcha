  worryzu <worryzu@evarentha.com> @LinearTeam

  Copyright (C) 2026 Evarentha
  SPDX-License-Identifier: GPL-3.0-or-later
%><div class="stack" data-lp-plugin="easy-captcha">
  <div class="page-header">
    <div><h1>人机验证</h1><p>在登录、注册和访客评论时要求验证，挡住批量注册、撞库和垃圾评论。登录用户发评论不需要验证。</p></div>
  </div>
  <% if (config.enabled && !ready) { %><div class="alert alert-warning" role="status"><div class="alert-body"><p>Turnstile 缺少站点 ID 或密钥，验证暂未生效。</p></div></div><% } %>
  <form class="stack" method="post" action="/admin/easy-captcha" data-dirty-guard>
    <section class="card stack">
      <label class="switch-row switch"><span><strong>启用人机验证</strong><small class="muted">关闭后所有表单都不再验证。</small></span><input type="checkbox" name="enabled"<%= config.enabled ? ' checked' : '' %>><span class="track" aria-hidden="true"></span></label>
      <fieldset class="field">
        <legend>在哪里验证</legend>
        <div class="cluster">
          <label class="check"><input type="checkbox" name="protect_login"<%= config.protectLogin ? ' checked' : '' %>><span>登录</span></label>
          <label class="check"><input type="checkbox" name="protect_register"<%= config.protectRegister ? ' checked' : '' %>><span>注册</span></label>
          <label class="check"><input type="checkbox" name="protect_comment"<%= config.protectComment ? ' checked' : '' %>><span>访客评论</span></label>
        </div>
      </fieldset>
      <fieldset class="field">
        <legend>验证方式</legend>
        <div class="ec-methods">
          <label class="choice"><input type="radio" name="method" value="text"<%= config.method === 'text' ? ' checked' : '' %> data-ec-method><span><strong>图片验证码</strong><small>在本站生成，不依赖外部服务。</small></span></label>
          <label class="choice"><input type="radio" name="method" value="turnstile"<%= config.method === 'turnstile' ? ' checked' : '' %> data-ec-method><span><strong>Cloudflare Turnstile</strong><small>多数情况下无需操作，需要 Cloudflare 账号。</small></span></label>
        </div>
      </fieldset>
    </section>

    <section class="card stack" data-ec-for="text">
      <h2 class="section-title">图片验证码</h2>
      <div class="ec-preview"><img src="<%= image %>?for=login&amp;t=<%= Date.now() %>" alt="当前设置下的验证码示例" width="120" height="40"><span class="help">保存后刷新页面可以看到新效果</span></div>
      <div class="form-row">
        <%- include('partials/field', { form: { values: { captcha_length: config.text.length }, errors: {} }, name: 'captcha_length', label: '字符数', type: 'number', attrs: 'min="3" max="8"' }) %>
        <%- include('partials/field', { form: { values: { captcha_charset: config.text.charset }, errors: {} }, name: 'captcha_charset', label: '字符类型', type: 'select', options: [{ value: 'both', label: '字母和数字' }, { value: 'number', label: '只有数字' }, { value: 'letter', label: '只有字母' }] }) %>
        <%- include('partials/field', { form: { values: { captcha_complexity: config.text.complexity }, errors: {} }, name: 'captcha_complexity', label: '干扰程度', type: 'select', options: [{ value: 1, label: '低' }, { value: 2, label: '中' }, { value: 3, label: '高' }] }) %>
        <%- include('partials/field', { form: { values: { captcha_distortion: config.text.distortion }, errors: {} }, name: 'captcha_distortion', label: '变形程度', type: 'select', options: [{ value: 1, label: '低' }, { value: 2, label: '中' }, { value: 3, label: '高' }] }) %>
      </div>
    </section>

    <section class="card stack" data-ec-for="turnstile">
      <h2 class="section-title">Cloudflare Turnstile</h2>
      <p class="help">在 Cloudflare 控制台的 Turnstile 中添加站点，把站点 ID 和密钥填到这里。</p>
      <div class="form-row">
        <%- include('partials/field', { form: { values: { turnstile_site_key: config.turnstile.siteKey }, errors: {} }, name: 'turnstile_site_key', label: '站点 ID（Site Key）', attrs: 'autocomplete="off" spellcheck="false"' }) %>
        <%- include('partials/field', { form: { values: {}, errors: {} }, name: 'turnstile_secret_key', label: '密钥（Secret Key）', type: 'password', placeholder: hasSecret ? '已保存，留空保持不变' : '尚未设置', attrs: 'autocomplete="new-password" spellcheck="false"' }) %>
      </div>
      <% if (hasSecret) { %><label class="check"><input type="checkbox" name="clear_secret"><span>清除已保存的密钥</span></label><% } %>
    </section>

    <section class="card stack">
      <h2 class="section-title">防止反复试错</h2>
      <div class="form-row">
        <%- include('partials/field', { form: { values: { max_failures: config.maxFailures }, errors: {} }, name: 'max_failures', label: '1 小时内最多错几次', type: 'number', attrs: 'min="1" max="100"' }) %>
        <%- include('partials/field', { form: { values: { ban_minutes: config.banMinutes }, errors: {} }, name: 'ban_minutes', label: '超过后暂停多久（分钟）', type: 'number', attrs: 'min="1" max="1440"' }) %>
      </div>
      <p class="help">按 IP 计算，不会因为别人输错而锁住你的账号。</p>
    </section>
    <div class="cluster"><button class="btn btn-primary" type="submit">保存设置</button></div>
  </form>
  <form method="post" action="/admin/easy-captcha/unban" data-confirm="所有因输错验证码而被暂停的 IP 都会立即恢复。" data-confirm-title="解除临时封禁" data-confirm-text="解除"><button class="btn btn-ghost" type="submit">解除所有临时封禁</button></form>
</div>
